# §12 — Configuration.
#
# Nothing here is required to run: every connector has a fixture fallback and
# every fixture-backed card is visibly marked. Fill these in to flip connectors
# from fixture to live — no code change needed.
#
# Thresholds and SLOs deliberately live in the database (/settings), not here,
# so ops can tune them without a deploy.

# ── App ──────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=
NEXTAUTH_SECRET=
# email:role pairs, or @domain:role for a whole domain. Roles: exec|pm|eng|ops
AUTH_ALLOWLIST=
DATABASE_URL=
# A genuinely read-only role. Generated SQL (/api/ask) only runs against this —
# never the read-write pool. The regex guard is defence in depth; this is the
# actual security boundary.
DATABASE_URL_READONLY=
TZ_DISPLAY=Asia/Kolkata
# Required in production: salts the customer_id hash (§27.4).
CUSTOMER_ID_SALT=
# Protects /api/cron/* so a public URL cannot trigger a BigQuery scan.
CRON_SECRET=

# ── Identity (§0 — production only) ──────────────────────────────────────────
COMPANION_PROD_AFFILIATE_ID=6978c8d5b2f0316521d38b37
TOTAL_TRENDS_STORES=1765
DEFAULT_TENANT=trends

# ── App entry points (§2.7) ──────────────────────────────────────────────────
COMPANION_PROD_ENTRY_URL=https://www.ajio.com/companion_app?store_id={store_id}
COMPANION_PROD_API_HOST=https://trends-companion-app.jiocommerce.io
DEFAULT_TEST_STORE_ID=617

# ── BigQuery (§13.2) ─────────────────────────────────────────────────────────
GCP_PROJECT_ID=sng-prod
# base64-encoded service account key, or raw JSON. Never written to disk.
GCP_SA_KEY_JSON=
BQ_ORDERS_TABLE=sng-prod.sng_analytics_dwh.avis_base_view
BQ_ITEM_TABLE=sng-prod.orbis_pipe_dwh.item
# §5.4b — catalogue *completeness* (Geckoboard summary tables). In sng-prod, so
# reachable with the same credential as orders.
BQ_CATALOGUE_HEALTH_DATASET=sng-prod.catalogue_health
# §13.1 / A4 — UNKNOWN, and the highest-leverage unblock in the build. It gates
# the funnel, the Scan Strip, and scan-level catalogue analysis. Resolve with
# the INFORMATION_SCHEMA.SCHEMATA query in §16.1 — likely ten seconds' work once
# BigQuery access exists. Do NOT guess `analytics_524294430`.
BQ_GA4_PROJECT=
BQ_GA4_DATASET=
# Hard per-query cost ceiling, in bytes. Default 50 GiB.
BQ_MAX_BYTES_BILLED=53687091200
# A2 — set to 100 only after confirming values are paise, against the ₹3.29 L
# April baseline. A wrong value here is wrong by 100× and looks entirely normal.
BQ_ORDERS_CURRENCY_DIVISOR=1
# §13.7 — if request durations are sunk to BigQuery, name the table here.
BQ_LATENCY_TABLE=

# ── GA4 ──────────────────────────────────────────────────────────────────────
GA4_PROPERTY_ID=524294430
GA4_ACCOUNT_ID=384216496

# ── Slack (Appendix B) ───────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_CATALOGUE_CHANNEL=C0AV6FU1YUU
SLACK_ALERTS_CHANNEL=C0B0APYNZTQ
SLACK_NOC_CHANNEL=C0BFJQDV05N
SLACK_DIGEST_CHANNEL=

# Fallbacks while `AI Dashboard Bot` (A0908SBQHJP) waits on a workspace
# reinstall with channels:history, files:read and chat:write.
#
# SLACK_WEBHOOK_URL keeps alerting alive without chat:write. It posts to the one
# channel chosen when the webhook was created, so it cannot route — every post
# through it says so rather than appearing to have gone where it was addressed.
SLACK_WEBHOOK_URL=

# A directory of exported Slack JSON, read only after a live read has failed.
# Files must contain the channel id in the name, e.g. C0AV6FU1YUU-2026-08-15.json,
# and hold either a bare array of messages or a conversations.history response.
# Anything served from here renders as `cache` with its age stated — never live.
SLACK_SNAPSHOT_DIR=

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_ORG=fynd-f7
SENTRY_AUTH_TOKEN=
# comma-separated project ids
# The seven services that alert into #companion-app-alerts, read off the real
# alerts rather than guessed. Sentry's short ids (HASHIRA-1J, GRINGOTTS-1JZB)
# name these, and the nightly EOD digest lists exactly this set.
SENTRY_PROJECTS=avis,computron,silverbolt,cartorderproxy,hashira,gringotts,megatron

# ── Jira ─────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://gofynd.atlassian.net
JIRA_PROJECT_KEY=NI
JIRA_BOARD_ID=11030
JIRA_EMAIL=
JIRA_API_TOKEN=
# A11 — the NI board is shared across Companion, Scan & Go, Kiosk and the
# Catalogue pipeline. Without this the P0 count inherits other products' bugs
# and the App Health Score is wrong.
JIRA_COMPONENT_FILTER=

# ── Sheets ───────────────────────────────────────────────────────────────────
SHEET_STORE_MASTER_ID=11eqPcFZnGm4mAG0SS5DvS_4o8IwcpJSMsXE_HorQreE
SHEET_GA4_EVENTS_ID=1vbYPH919bSLRcYPz273X3Tz2QPOprXmhU4Mb8ehJwNY
SHEET_TASKS_ID=1cG0HJ-Ekw_0emZ2o47uqZ66Yq7W-l0ZC2ZONxUcddoQ

# ── AI (§28) ─────────────────────────────────────────────────────────────────
# Without this the daily brief falls back to a deterministic summary, clearly
# labelled. No insight beats a wrong insight.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_BRIEF_CRON=0 8 * * *

# ── Modules (§0) ─────────────────────────────────────────────────────────────
# §0 excludes Loyalty from v1. It was wired anyway on explicit direction —
# see docs/decisions/ADR-001-loyalty-scope.md for the decision and what follows
# from it. Note fynd-jio-impetus-prod is a DIFFERENT GCP project: the Companion
# service account very likely needs a separate IAM grant to read it.
MODULE_LOYALTY=false
BQ_LOYALTY_PROJECT=fynd-jio-impetus-prod
BQ_LOYALTY_DATASET=
MODULE_AMPLITUDE=false
MODULE_TRUE_COVERAGE=false

# ── The rest, for completeness ───────────────────────────────────────────────
# Every variable the code reads is listed in this file. A test enforces that,
# because a connector whose credential is not documented anywhere is one nobody
# will ever configure — it just sits grey on /connectors forever.

# §24 — Amplitude is gated behind MODULE_AMPLITUDE *and* a key. The §24
# question ("which events exist here but not in GA4?") should be answered
# before turning it on; two analytics sources that disagree is worse than one.
AMPLITUDE_API_KEY=

# §13.7 / A10 — the latency source is undecided (APM vs logs vs synthetic).
# Setting this to `true` marks the numbers as synthetic probes rather than
# real user latency, so the distinction survives onto the card.
LATENCY_SYNTHETIC=false

# §9.4 — until an IdP is provisioned the app runs in open mode with a visible
# banner. These two make a local session concrete without one.
DEFAULT_ROLE=pm
DEV_USER_EMAIL=

# Seeding fixture rows into a mart is refused under NODE_ENV=production, because
# fixture rows cannot be told apart from real ones afterwards. This is the
# override, spelled awkwardly on purpose. You almost certainly do not want it.
# ALLOW_FIXTURE_SEED=i-understand

# ── Catalogue master (§20.2) ─────────────────────────────────────────────────
# The RBL structured catalogue, in a DIFFERENT GCP project from Companion's own
# — the same separate-IAM-grant lesson as ADR-001.
#
# CAUTION: in rbl_catalog_structured_v7, 49,955 of the first 50,000 variant rows
# carry gtin_type='ALU' — Reliance's internal Article Level Unit, not a barcode.
# Only barcode-family types reach dim_product.ean; see ADR-001's addendum. If
# you point this at a dataset whose EANs are really ALUs, the cardinality
# assertion hard-fails and the mart keeps its last good snapshot rather than
# reporting the whole catalogue as absent from the master.
BQ_CATALOGUE_PROJECT=fynd-jio-impetus-prod
BQ_CATALOGUE_DATASET=rbl_catalog_structured_v7

# The Scan-and-Go catalogue — the real EAN master, and what the CAUTION above
# was waiting for. `analytics_boltic_sng.catalog` carries `seller_identifier`,
# and reading it shows genuine GS1 barcodes rather than ALUs: 6.52 M rows,
# 2.52 M distinct active barcoded EANs. Preferred over the RBL path when set,
# because a master of internal article codes cannot answer the only question
# the catalogue mart exists for — was this scanned barcode listed.
BQ_SNG_PROJECT=fynd-jio-impetus-prod
BQ_SNG_DATASET=analytics_boltic_sng

# Ceiling on the catalogue load, for an environment that cannot hold 2.5 M rows.
# 0 = no cap. A truncated master is published as a truncated master: without the
# disclosure, every EAN past the cap would read as a genuine catalogue gap.
BQ_CATALOGUE_MAX_ROWS=0

# Override the project `npm run discover` maps. Defaults to GCP_PROJECT_ID.
BQ_DISCOVER_PROJECT=

# ── Stored credentials (§9.5) ────────────────────────────────────────────────
# Encrypts credentials added from /connectors/sources, so a NOC lead handed a
# token can connect a source without a redeploy.
#
# There is no default and no "encryption off" mode: a hardcoded fallback key is
# no encryption while looking like encryption, which is worse, because it stops
# anyone asking. Without this set, the sources page refuses to store anything
# and says so — the environment variables below keep working untouched.
#
#   openssl rand -base64 32
CREDENTIAL_KEY=
